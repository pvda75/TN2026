rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    match /globals/{docId} {
      // For shared account data and configs, we allow reads.
      allow read: if true;
      allow create, update: if 
        (docId.matches('^scanQueue.*')) ||
        (request.resource.data.keys().hasAll(['appUsers', 'classes', 'examConfigs']) &&
         request.resource.data.appUsers is list &&
         request.resource.data.classes is list &&
         request.resource.data.examConfigs is list);
    }
    
    match /scanHistory/{historyId} {
      allow read, write: if true;
    }
  }
}
