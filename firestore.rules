rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    match /globals/{docId} {
      // Allow read and write for everyone to ensure global configurations, queues, and deleted trackers are synchronized.
      allow read, write: if true;
    }
    
    match /scanHistory/{historyId} {
      allow read, write: if true;
    }
  }
}
